# ─────────────────────────────────────────────────────────────────────────────
# EDULINUX — Configuration de production
# ─────────────────────────────────────────────────────────────────────────────
#
# UTILISATION
#   cp .env.production.example .env.production
#   nano .env.production   (remplir chaque valeur)
#
# RÈGLES ABSOLUES
#   - Ne jamais commiter .env.production dans git
#   - Ne jamais réutiliser les mêmes secrets entre dev et prod
#   - Ne jamais laisser les valeurs "CHANGE_ME_*" ou "xxx" telles quelles
#
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────

# URL publique de l'application (avec protocole, sans slash final)
# Utilisé pour : validation de l'origin WebSocket (CSRF protection)
# Exemple : https://edulinux.mondomaine.com
NEXT_PUBLIC_APP_URL=https://CHANGE_ME.example.com

# Port d'écoute du serveur Node.js (Nginx proxie vers ce port)
PORT=3000

# ── Supabase ──────────────────────────────────────────────────────────────────
#
# Récupérer ces valeurs dans :
# Supabase Dashboard → Project Settings → API
#
# NEXT_PUBLIC_* : visibles côté client (browser) — clé anon uniquement
# SUPABASE_SERVICE_ROLE_KEY : secrète, côté serveur uniquement, jamais exposée

NEXT_PUBLIC_SUPABASE_URL=https://XXXXXXXXXXXXXXXX.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.CHANGE_ME
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.CHANGE_ME_SERVICE_ROLE

# ── Sécurité PTY ──────────────────────────────────────────────────────────────
#
# Clé HMAC-SHA256 pour signer les tokens d'accès au terminal.
# OBLIGATOIRE : si absent, le serveur génère une clé aléatoire à chaque
# démarrage → toutes les sessions actives sont invalidées à chaque reboot.
#
# GÉNÉRER avec cette commande (à lancer une seule fois sur ton serveur) :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Exemple de sortie (NE PAS copier cet exemple, génère le tien) :
#   a3f8e2d1c4b5907623841fedcba09876543210abcdef1234567890abcdef1234
#
PTY_TOKEN_SECRET=CHANGE_ME_64_CHARS_HEX

# ── Logging ───────────────────────────────────────────────────────────────────
#
# Niveau de log Pino : trace | debug | info | warn | error | fatal
# En production : info (recommandé)
# Pour déboguer un problème temporairement : debug
LOG_LEVEL=info

# ── Supabase RLS — ÉTAPE OBLIGATOIRE AVANT MISE EN PRODUCTION ─────────────────
#
# Sans Row Level Security, chaque utilisateur peut lire les données des autres.
#
# Étapes :
# 1. Ouvrir le SQL Editor de ton projet Supabase :
#    https://supabase.com/dashboard/project/<ton-projet>/sql
#
# 2. Copier-coller et exécuter le contenu de :
#    supabase/migrations/20260413000000_rls.sql
#
# 3. Vérifier que ça a marché (les deux lignes doivent afficher rowsecurity = true) :
#    SELECT tablename, rowsecurity
#    FROM pg_tables
#    WHERE tablename IN ('user_progress', 'user_notes');

# ── Docker Labs (optionnel) ───────────────────────────────────────────────────
#
# Utilisé par les scénarios pentest avancés (niveaux 11-20).
# Laisser vide ou supprimer ces lignes si les labs Docker ne sont pas utilisés.
#
# GÉNÉRER des mots de passe sécurisés avec (lancer deux fois pour avoir deux valeurs) :
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
#
# Les valeurs ci-dessous sont des placeholders — elles DOIVENT être remplacées
# avant de lancer les containers en production.

LAB_MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD
LAB_MYSQL_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
